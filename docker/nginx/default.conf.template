# Servidor de la PWA. ${API_UPSTREAM} se reemplaza al arrancar el contenedor.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Nginx no conoce la extensión del manifest de la PWA.
    include /etc/nginx/mime.types;
    types {
        application/manifest+json webmanifest;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
    gzip_min_length 1024;

    # API: se reenvía al backend, así el navegador ve un solo origen (sin CORS).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Service Worker, manifest e index: siempre se revalidan para recibir actualizaciones.
    location ~* ^/(sw\.js|workbox-.*\.js|registerSW\.js|manifest\.webmanifest|index\.html)$ {
        add_header Cache-Control "no-cache";
    }

    # Archivos con hash en el nombre: se pueden cachear para siempre.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: cualquier ruta (p. ej. /salas) carga index.html y la resuelve React Router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
